# App
PROJECT_NAME=QuizAI
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quizai
POSTGRES_PASSWORD=
POSTGRES_DB=quizai
DATABASE_URL=postgresql+psycopg://quizai:change-me-local-only@localhost:5432/quizai

# Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_ISSUER=http://localhost:8080/realms/quizai
KEYCLOAK_AUDIENCE=quizai-api
KEYCLOAK_CLIENT_ID=quizai-web

# Ollama (LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
